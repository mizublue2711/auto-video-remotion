{
  "name": "auto-video-remotion",
  "version": "1.0.0",
  "description": "Remotion Cloud Run video rendering automation",
  "type": "module",
  "main": "scripts/render-cloud.js",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle src/index.ts --out-dir=dist/bundle",
    "render": "node scripts/render-cloud.js",
    "render:site": "node scripts/render-site.js",
    "validate:configs": "tsx scripts/validate-configs.ts",
    "export:schema": "tsx scripts/export-json-schemas.ts"
  },
  "dependencies": {
    "@remotion/cloudrun": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@rive-app/react-canvas": "^4.38.0",
    "dotenv": "^16.4.5",
    "lottie-react": "^3.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
